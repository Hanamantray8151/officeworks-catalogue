
# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

NODE_ENV=development

# ==========================================
# BACKEND CONFIGURATION
# ==========================================

API_PORT=4000

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/backend

# ==========================================
# PRODUCT DATA PROVIDER
# ==========================================

PRODUCT_API_BASE_URL=https://fakestoreapi.com

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ==========================================
# SALES ENQUIRY CONFIGURATION
# ==========================================

SALES_INBOX_EMAIL=sales@example.com
EMAIL_FROM=Catalogue Enquiries <no-reply@example.com>
